<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvMonitorState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/card_red"
            android:gravity="center"
            android:padding="12dp"
            android:text="Test RUNNING..."
            android:textColor="@color/red_bright"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@color/surface_red_dark"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/tvSsid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SSID: -"
                android:textColor="@color/text_white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvBssid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="BSSID: -"
                android:textColor="@color/red_soft"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvEncryption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Encryption: -"
                android:textColor="@color/red_soft"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvSignal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Signal level: -"
                android:textColor="@color/red_soft"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvCurrentPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Password: -"
                android:textColor="@color/red_bright"
                android:textSize="17sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/pbTestProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:layout_marginTop="10dp"
                android:max="100"
                android:progress="0"
                android:progressTint="@color/red_primary" />

            <TextView
                android:id="@+id/tvQueueProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="0 of 0"
                android:textColor="@color/text_white"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvSpeed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Speed: 0 passwords/minute"
                android:textColor="@color/red_soft"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvEstimatedTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Estimated time: 0 hr, 0 min"
                android:textColor="@color/red_soft"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@color/card_red"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <Button
                android:id="@+id/btnSpeedMinus"
                android:layout_width="56dp"
                android:layout_height="48dp"
                android:backgroundTint="@color/red_primary"
                android:text="-"
                android:textColor="@color/text_white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvIntervalValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="سرعة المحاولة: 7 ثواني"
                android:textColor="@color/text_white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnSpeedPlus"
                android:layout_width="56dp"
                android:layout_height="48dp"
                android:backgroundTint="@color/red_primary"
                android:text="+"
                android:textColor="@color/text_white"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/btnPauseResume"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:backgroundTint="@color/red_primary"
            android:text="Pause"
            android:textColor="@color/text_white"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
